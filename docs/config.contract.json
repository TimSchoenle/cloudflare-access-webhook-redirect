  "json_schema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "cloudflare": {
        "additionalProperties": false,
        "properties": {
          "client_id": {
            "description": "`CF-Access-Client-Id` header value.",
